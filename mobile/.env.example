# Copy to .env and fill in before running a development or production build.
# Every EXPO_PUBLIC_* value is embedded in the JS bundle — put only publishable
# keys here. RevenueCat SDK keys are designed to be public; the secret key is not.

# RevenueCat > Project settings > API keys > App-specific public key (Apple)
EXPO_PUBLIC_RC_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxxxxx

# RevenueCat > Project settings > API keys > App-specific public key (Google)
EXPO_PUBLIC_RC_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxxxxx
